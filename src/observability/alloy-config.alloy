local.file_match "docker_logs" {
  path_targets = [{
    __path__ = "/var/lib/docker/containers/*/*log",
    job      = "containerlogs",
  }]
}

loki.source.file "docker" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.parse_pino.receiver]
}

loki.process "parse_pino" {
  forward_to = [loki.write.loki_push.receiver]

  stage.json {
    expressions = {
      output = "log",    
      stream = "stream",
    }
  }

  stage.json {
    source      = "output"
    expressions = {
      level     = "level",
      requestId = "requestId",
      msg       = "msg",
    }
  }

  stage.labels {
    values = {
      level  = "",
      stream = "",
    }
  }

  stage.output {
    source = "output"   
  }
}

loki.write "loki_push" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}